# Secrets and machine/cluster-local context — never committed
.env
.env.*
!.env.example
CLAUDE.local.md
*.kubeconfig
kubeconfig

# Runtime data — the DB and datasheet blob store live here.
# Must be `data/*` not `data/`: git does not descend into an ignored
# directory, so a negation inside it would never take effect.
data/*
!data/.gitkeep

# A pattern containing a slash is anchored to this file's directory, so the
# rule above covers only the repo-root data/. app.config resolves relative
# paths against the repo root precisely so a stray backend/data/ never appears
# — these are the belt to that braces, including SQLite's WAL sidecars.
*.db
*.db-wal
*.db-shm

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/
.coverage
.coverage.*
coverage.xml
htmlcov/
junit.xml

# Node
node_modules/
.vite/
# A port-rewritten copy of vite.config.ts, used to point a throwaway dev server at
# a scratch API. Local scaffolding, never the app's config.
frontend/vite.config.*.ts
frontend/dist/
frontend/coverage/
*.tsbuildinfo

# Submodules (mensa, circinus, ecia-barcode, elec-value-parser) carry their own
# .gitignore — do not duplicate their build artefacts here.

# Editors / OS
.DS_Store
.idea/
*.swp

# Claude Code's isolated agent worktrees. These are real git worktrees of this
# same repo, so committing one nests a repository inside itself.
.claude/worktrees/
certs/
