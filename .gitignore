# Secrets and machine/cluster-local context — never committed
.env
.env.*
!.env.example
CLAUDE.local.md
*.kubeconfig
kubeconfig

# Runtime data — the DB and datasheet blob store live here.
# Must be `data/*` not `data/`: git does not descend into an ignored
# directory, so a negation inside it would never take effect.
data/*
!data/.gitkeep

# A pattern containing a slash is anchored to this file's directory, so the
# rule above covers only the repo-root data/. app.config resolves relative
# paths against the repo root precisely so a stray backend/data/ never appears
# — these are the belt to that braces, including SQLite's WAL sidecars.
*.db
*.db-wal
*.db-shm

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/
.coverage
.coverage.*
coverage.xml
htmlcov/
junit.xml

# Node
node_modules/
.vite/
# A port-rewritten copy of vite.config.ts, used to point a throwaway dev server at
# a scratch API. Local scaffolding, never the app's config.
frontend/vite.config.*.ts
frontend/dist/
frontend/coverage/
*.tsbuildinfo

# Submodules (mensa, circinus, ecia-barcode, elec-value-parser) carry their own
# .gitignore — do not duplicate their build artefacts here.

# Editors / OS
.DS_Store
.idea/
*.swp

# Claude Code's isolated agent worktrees. These are real git worktrees of this
# same repo, so committing one nests a repository inside itself.
.claude/worktrees/
certs/

# Benchmark output: one directory per run, holding JSONL records and PNGs. Big,
# regenerable, and meaningless outside the machine that produced it.
out/bench/
# The datasheets a benchmark run fetches. Kept out deliberately — redistribution
# rights are not ours to assume. `case.json` records each one's sha256 so the
# corpus can re-fetch and verify them.
bench/corpus/_pdfs/

# Photographs. **Never committed**, on the same principle as the datasheets and
# one stronger: a capture is a picture somebody took of their own bench, and a
# git history is forever. `case.json` records `capture_sha256`, and the image
# lives either in a running Almagest (upload it with
# `python -m app.scripts.upload_capture`) or in the local cache below, which the
# corpus loader checks first and which git never sees.
bench/corpus/_captures/
bench/corpus/**/capture.jpg
bench/corpus/**/capture.png

# Extracted datasheet **text**, for the extraction sweep. Same principle as the
# PDFs it came out of: redistribution rights are not ours to assume, and a git
# history is forever — the XBee photograph still in this history is the standing
# reminder of how hard that is to undo.
#
# `case.json` records `text_sha256`, so a corpus is still reproducible: the text
# is fetched once (`almagest-bench corpus fetch-text`) and verified against the
# hash before anything scores against it. The cost of this choice, stated
# plainly: a fresh clone cannot reproduce an extraction run until it re-fetches.
bench/corpus/_text/
