{
  "components": {
    "schemas": {
      "AliasKind": {
        "description": "*Which part of a scanned label* a `barcode_aliases.code_norm` is.\n\n`entity_type` says what the alias points at and `symbology` says what\ncarried it; this says what was bound, which is the only one of the three\nthe resolver has to know in order to look anything up. The distinction is\nload-bearing rather than descriptive: a whole DigiKey reel payload contains\nthe lot and the quantity, so binding it resolves *that one reel* forever\nand carries `hint_qty_milli`/`hint_batch` with it \u2014 while binding the\nsupplier SKU lifted out of the same payload is what makes the *next* reel\nof the same part resolve on its first scan.",
        "enum": [
          "whole_payload",
          "mpn",
          "supplier_sku",
          "package_code",
          "tag_uid"
        ],
        "title": "AliasKind",
        "type": "string"
      },
      "EntityType": {
        "description": "Discriminator for the shared short-ID space and other polymorphic links.\n\nOne ID space across all object types means a scan resolves without knowing\nwhat it scanned, and an object that gets reclassified keeps its printed\nlabel. The type is a *display prefix* only \u2014 never parsed from the code.",
        "enum": [
          "part",
          "location",
          "stock_lot",
          "container_type",
          "part_category",
          "supplier_part",
          "document",
          "project",
          "device"
        ],
        "title": "EntityType",
        "type": "string"
      },
      "FilterIn": {
        "properties": {
          "template": {
            "description": "`parameter_template.name`, e.g. 'capacitance'",
            "title": "Template",
            "type": "string"
          },
          "value": {
            "description": "Interpreted according to the template. Numeric templates accept the full shorthand grammar ('4k7', '20-30uF', '>=50V'); enum templates accept a choice key or any alias, comma-separated for OR.",
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "template",
          "value"
        ],
        "title": "FilterIn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
