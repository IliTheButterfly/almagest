  "info": {
    "summary": "Self-hosted electronic-component inventory.",
    "title": "Almagest",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/resolve/{short_id}": {
      "get": {
        "description": "Machine-readable resolution, for the PWA and `deviceagent`.",
        "operationId": "resolve_short_id",
        "parameters": [
          {
            "in": "path",
            "name": "short_id",
            "required": true,
            "schema": {
              "title": "Short Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResolveResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Resolve Short Id",
        "tags": [
          "resolve"
        ]
      }
    },
    "/api/scan/alias": {
      "post": {
        "description": "Teach the system what a payload means. The other half of the loop.\n\nIdempotent: re-binding the same code to the same entity updates the row and\ncounts as a hit rather than failing, because a user who binds the same label\ntwice is confirming it.",
        "operationId": "bind_barcode_alias",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanAliasRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanAliasResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Bind Barcode Alias",
        "tags": [
          "scan"
        ]
      }
    },
    "/api/scan/resolve": {
      "post": {
        "description": "Identify a scanned payload. **Never rejects one.**\n\nAn unrecognised code comes back `unknown` with `suggest_bind`, not as an\nerror \u2014 a scan that gets refused teaches the user to stop scanning, and\nintake friction is what kills systems like this one.",
        "operationId": "resolve_scan",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanResolveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResolveResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Resolve Scan",
        "tags": [
          "scan"
        ]
      }
    },
    "/api/search/parts": {
      "get": {
        "operationId": "search_parts_by_querystring",
