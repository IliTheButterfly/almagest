# Copy to .env and fill in. .env is gitignored; never commit real values.
# In-cluster these become a Secret (note: the service account can create/update
# but NOT delete secrets — rotate by applying a new value, not delete+recreate).

# --- Core ---
ALMAGEST_DB_PATH=./data/almagest.db
# Root of the content-addressed document store: {sha256[0:2]}/{sha256[2:4]}/{sha256}.pdf.
# Holds every stored file, not only PDFs — tray photographs for vision counting land
# in the same tree — so back it up with the database, and never point it at network
# storage the API cannot rename within.
ALMAGEST_DATASHEET_DIR=./data/datasheets
ALMAGEST_LABEL_OUTPUT_DIR=./data/labels
# Physically written into every NFC tag and printed QR as {base}/s/{short_id}.
# SETTLED: deployed instances use https://almagest.aether.lan — see docs/adr/0001.
# It must be https: Web NFC and getUserMedia are gated behind a secure context,
# so over plain http the PWA silently loses tag writing and barcode scanning.
# Requires a privately-issued cert whose CA is trusted on every phone.
# localhost is a secure context by spec, so development needs no certificate.
ALMAGEST_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# --- Parts data providers (all optional; the system works with none) ---
# Mouser: free, single key, no OAuth. Start here.
MOUSER_API_KEY=
# DigiKey Product Information API v4: OAuth2 + one-time manual app approval, ~1000 req/day
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
# Nexar/Octopart: OAuth2 client credentials. Free tier starts at zero parts until requested;
# datasheets/specs are gated out of the mid paid tier.
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=
# LCSC has no official API — a local jlcparts SQLite dump is used instead.
JLCPARTS_DB_PATH=./data/jlcparts.sqlite

# --- LLM datasheet extraction (Phase 6) ---
ANTHROPIC_API_KEY=

# --- MCP server (the inventory as tools an agent can call) ---
# The API as reachable FROM WHEREVER THE AGENT RUNS — a laptop, a CI job, a
# container next to the API. Same distinction as DEVICEAGENT_API_BASE_URL below and
# for the same reason: ALMAGEST_BASE_URL is the public origin stamped onto physical
# labels and tags, and must stay put whatever route a client takes to the server.
ALMAGEST_MCP_API_BASE_URL=http://127.0.0.1:8000
# Generous next to the agent's 5 s. Nothing here is holding a container over a
# reader, and the expensive reads are genuinely expensive: BOM suggestions run a
# parametric search per unmatched line. A timeout mid-BOM is a worse answer than a
# slow one.
ALMAGEST_MCP_TIMEOUT_S=30
# OFF BY DEFAULT, and read mcpserver/README.md before changing it. Reads are
# recoverable by definition; a write is recoverable (the ledger's undo is a
# compensating row) but not invisible — until somebody recounts that bin, a wrong
# balance is a confident lie about physical reality, and the point of this system is
# that the balance can be trusted. Turn it on if you want an agent adjusting stock.
ALMAGEST_MCP_ALLOW_WRITES=false
# Stamped on every ledger row the MCP server writes, alongside source="api", so
# "which of these movements did an agent make" is a WHERE clause.
ALMAGEST_MCP_DEVICE_ID=mcp

# --- Device agent (runs on the Pi, not in-cluster) ---
# The API as reachable FROM THE PI, which is not ALMAGEST_BASE_URL above: that one
# is the public origin stamped into every tag and printed label and must stay put
# whatever route the agent takes to the server. The default is the dev loop's
# `make run`; there is no correct default for a Pi. https needs the private CA of
# docs/adr/0001 installed in the Pi's trust store — there is deliberately no
# switch to skip verification.
# (This replaces the never-read ALMAGEST_API_URL that used to sit here.)
DEVICEAGENT_API_BASE_URL=http://127.0.0.1:8000
# How long one placement or commit may hold up the poll loop, which awaits the
# session's round trip inline: interleaving a commit with a container swap is a
# ledger row against the wrong bin, a late-noticed removal costs a moment.
DEVICEAGENT_API_TIMEOUT_S=5
# Recorded on every movement this station commits (client_operations.device_id),
# which is what lets "which bench moved this" be answered.
DEVICEAGENT_DEVICE_ID=station
# PLAN.md debounces a provisioning tap at 400 ms and the PWA reuses that number
# for decode feedback; the station reuses it a third time so a double-tapped
# Commit is one commit. 0 disables it, which is for tests.
DEVICEAGENT_COMMAND_DEBOUNCE_MS=400
# The ESP32 owns the scale ADC and the LEDs. Deferred, not bought: see
# docs/adr/0003 — nothing in deviceagent reads this key yet.
DEVICEAGENT_SERIAL_PORT=/dev/ttyUSB0          # ESP32 station controller
# Which NFC reader is wired to this station: pn532 (what PLAN.md specifies) or
# rc522 (docs/adr/0013 — an MFRC522 that was already on the shelf, with less range
# margin and a driver this repo owns). Only the chosen one's keys below are read,
# and only its library needs to be installed. `--reader` overrides this for one run.
#
# A third value, `none`, says this machine has no platform reader at all — the
# laptop-with-a-Flipper shape ADR 0014 widened the bridge to cover, and what
# deploy/station/ configures on the Jetson. The station loop then reports an
# empty platform forever and only the bridge's USB readers matter. Do not reach
# for `--fake` to get that: it replays a placement on a loop and narrates a
# container that is not on the bench.
DEVICEAGENT_READER=pn532
DEVICEAGENT_PN532_PORT=/dev/ttyAMA0           # NFC reader, UART mode
# RC522 only: /dev/spidev<bus>.<device>, so CE0 on a Pi's primary bus is 0 and 0.
# Enable SPI in raspi-config, and tie the module's RST pin to 3V3 — this driver
# does not drive a reset line, and a floating RST reads as "no reader present".
DEVICEAGENT_RC522_SPI_BUS=0
DEVICEAGENT_RC522_SPI_DEVICE=0
DEVICEAGENT_RC522_SPI_HZ=1000000              # the chip's ceiling is 10 MHz
# The event stream the kiosk PWA subscribes to. Refused if it is not a loopback
# address: the socket is unauthenticated and narrates every container handled at
# the bench, and binding it wider fails silently rather than visibly.
DEVICEAGENT_WS_HOST=127.0.0.1
DEVICEAGENT_WS_PORT=8765
# Both budgets are counts of POLLS; POLL_INTERVAL_MS is the poll period (the loop
# sleeps interval-minus-elapsed, not the interval flat). IDENTIFY_POLLS x
# POLL_INTERVAL_MS therefore *bounds* PLAN.md's ~5 tries / 1.5 s identify budget —
# an upper bound, and only while one read fits inside one interval. The PN532 burns
# 250 ms of anticollision timeout on every poll that finds nothing, and nobody has
# measured a real reader; an overrun is logged, not silent. See deviceagent/README.md,
# "The budgets are counts of polls" and "Unverifiable without hardware".
# ABSENT_POLLS empty polls confirm a container was removed — lower it and
# a single dropped read aborts a session mid-commit; raise it and the next
# container lands before the last was released.
DEVICEAGENT_POLL_INTERVAL_MS=300
DEVICEAGENT_IDENTIFY_POLLS=5
DEVICEAGENT_ABSENT_POLLS=3

# --- The device bridge (ADR 0014) --------------------------------------------
# The agent also discovers readers the browser cannot reach and offers them to
# the PWA over the same loopback socket. This is what lets a machine with no Web
# NFC — a desktop, an iPhone, the Pi kiosk itself — read *and write* a tag.
#
# Look for Flippers on USB. On by default: it is a listing of
# /dev/serial/by-id, which costs nothing and finds nothing when nothing is
# plugged in.
DEVICEAGENT_FLIPPER_USB=1
#
# Look for Flippers over Bluetooth. **Off, and that is about verification rather
# than preference** — no Bluetooth stack existed on the machine this was written
# on, so `BleFlipperLink` has never executed. It also needs the `flipper` extra
# for bleak. Read ADR 0014's "unverified" section before switching it on.
DEVICEAGENT_FLIPPER_BLE=0
#
# How often to look for readers appearing or vanishing, and how often each
# attached one is asked for a tag. The tap interval is deliberately slower than
# POLL_INTERVAL_MS: that one paces the station's *budgets*, this one paces a
# hand holding a tag against a Flipper.
DEVICEAGENT_SWEEP_INTERVAL_MS=2000
DEVICEAGENT_TAP_INTERVAL_MS=500
#
# The origin allowed through the WebSocket handshake's CORS and Private Network
# Access checks — ALMAGEST_BASE_URL, normally. The PWA is served over https and
# opens ws://127.0.0.1, and while loopback is "potentially trustworthy" per the
# secure-context spec, Chrome's Private Network Access rollout adds a preflight.
# Getting this wrong costs a bridge that is running, answers curl, and is
# invisible to the page.
DEVICEAGENT_ALLOWED_ORIGIN=https://almagest.aether.lan
