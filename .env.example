# Copy to .env and fill in. .env is gitignored; never commit real values.
# In-cluster these become a Secret (note: the service account can create/update
# but NOT delete secrets — rotate by applying a new value, not delete+recreate).

# --- Core ---
ALMAGEST_DB_PATH=./data/almagest.db
# Root of the content-addressed document store: {sha256[0:2]}/{sha256[2:4]}/{sha256}.pdf.
# Holds every stored file, not only PDFs — tray photographs for vision counting land
# in the same tree — so back it up with the database, and never point it at network
# storage the API cannot rename within.
ALMAGEST_DATASHEET_DIR=./data/datasheets
ALMAGEST_LABEL_OUTPUT_DIR=./data/labels
# Physically written into every NFC tag and printed QR as {base}/s/{short_id}.
# SETTLED: deployed instances use https://almagest.lan — see docs/adr/0001.
# It must be https: Web NFC and getUserMedia are gated behind a secure context,
# so over plain http the PWA silently loses tag writing and barcode scanning.
# Requires a privately-issued cert whose CA is trusted on every phone.
# localhost is a secure context by spec, so development needs no certificate.
ALMAGEST_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# --- Parts data providers (all optional; the system works with none) ---
# Mouser: free, single key, no OAuth. Start here.
MOUSER_API_KEY=
# DigiKey Product Information API v4: OAuth2 + one-time manual app approval, ~1000 req/day
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
# Nexar/Octopart: OAuth2 client credentials. Free tier starts at zero parts until requested;
# datasheets/specs are gated out of the mid paid tier.
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=
# LCSC has no official API — a local jlcparts SQLite dump is used instead.
JLCPARTS_DB_PATH=./data/jlcparts.sqlite

# --- LLM datasheet extraction (Phase 6) ---
ANTHROPIC_API_KEY=

# --- Device agent (runs on the Pi, not in-cluster) ---
ALMAGEST_API_URL=
DEVICEAGENT_SERIAL_PORT=/dev/ttyUSB0          # ESP32 station controller
DEVICEAGENT_PN532_PORT=/dev/ttyAMA0           # NFC reader, UART mode
