# Copy to .env and fill in. .env is gitignored; never commit real values.
# In-cluster these become a Secret (note: the service account can create/update
# but NOT delete secrets — rotate by applying a new value, not delete+recreate).

# --- Core ---
ALMAGEST_DB_PATH=./data/almagest.db
ALMAGEST_DATASHEET_DIR=./data/datasheets
ALMAGEST_BASE_URL=http://localhost:8000       # physically written into every NFC tag and
                                              # printed QR — settle the host before
                                              # provisioning tags, or all of them need rewriting
LOG_LEVEL=INFO

# --- Parts data providers (all optional; the system works with none) ---
# Mouser: free, single key, no OAuth. Start here.
MOUSER_API_KEY=
# DigiKey Product Information API v4: OAuth2 + one-time manual app approval, ~1000 req/day
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
# Nexar/Octopart: OAuth2 client credentials. Free tier starts at zero parts until requested;
# datasheets/specs are gated out of the mid paid tier.
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=
# LCSC has no official API — a local jlcparts SQLite dump is used instead.
JLCPARTS_DB_PATH=./data/jlcparts.sqlite

# --- LLM datasheet extraction (Phase 6) ---
ANTHROPIC_API_KEY=

# --- Device agent (runs on the Pi, not in-cluster) ---
ALMAGEST_API_URL=
DEVICEAGENT_SERIAL_PORT=/dev/ttyUSB0          # ESP32 station controller
DEVICEAGENT_PN532_PORT=/dev/ttyAMA0           # NFC reader, UART mode
