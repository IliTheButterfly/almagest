#!/usr/bin/env bash
#
# Claude Code (or OpenCode), driven by the Qwen 27B that Almagest runs on aether.
#
#   aether-code [claude args...]       start the model if needed, then code
#   aether-opencode [opencode args...] the same, with OpenCode as the client
#   aether-code status                 replicas, holds, and the KV-cache line
#   aether-code release                hand the GPU back now (if nobody holds it)
#
# `aether-opencode` is a symlink to this script; the name picks the client.
#
# vLLM serves Anthropic's /v1/messages natively, so this is real Claude Code with
# ANTHROPIC_BASE_URL pointed at a port-forward - no translating proxy. OpenCode
# talks to the same server's OpenAI-compatible /v1.
#
# LAN or warpdrive does not matter here: aether-route-fallback (a user timer)
# keeps the host route to aether's one address on whichever path answers, and
# the port-forward below reconnects when the route moves.
#
# While it runs it renews a Lease labelled `almagest.llm/hold`, which the
# almagest-llm-reaper honours; on exit the lease is deleted and the reaper hands
# the card back on its next pass. A crash just lets the lease expire.
#
# The server's context is small (--max-model-len), so below 96k the session runs
# lean: six tools, no MCP, no skills, no CLAUDE.md or auto-memory. That is ~4k
# tokens of prompt instead of ~35k. AETHER_CODE_FULL=1 forces the full setup.
# The window is read from the server, so raising --max-model-len needs no change.

set -euo pipefail

case "$(basename "$0")" in
  aether-opencode) CLIENT=opencode DEFAULT_PORT=18001 ;;
  *) CLIENT=claude DEFAULT_PORT=18000 ;;
esac

KCTX="${AETHER_KUBE_CONTEXT:-aether}"
NS=ili
DEPLOY=almagest-llm-27b
PORT="${AETHER_CODE_PORT:-$DEFAULT_PORT}"
LEASE_SECONDS=300
LEASE="aether-$CLIENT-$(id -un)-$(hostname -s)-$$"

k() { kubectl --context "$KCTX" -n "$NS" "$@"; }
say() { printf '\033[1;36m==>\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31mfatal:\033[0m %s\n' "$*" >&2; exit 1; }
now() { date -u +%Y-%m-%dT%H:%M:%S.%6NZ; }

live_holds() {
  k get leases -l almagest.llm/hold \
    -o jsonpath='{range .items[*]}{.metadata.name} {.spec.renewTime} {.spec.leaseDurationSeconds}{"\n"}{end}' |
    while read -r name renewed duration; do
      [ -n "$name" ] || continue
      if (( $(date -u -d "$renewed" +%s) + duration > $(date -u +%s) )); then
        echo "$name (renewed $renewed)"
      fi
    done
}

cmd_status() {
  k get deploy almagest-llm almagest-llm-27b \
    -o custom-columns=NAME:.metadata.name,WANT:.spec.replicas,READY:.status.readyReplicas
  echo "holds:"; live_holds | sed 's/^/  /'
  local pod
  pod="$(k get pods -l app.kubernetes.io/component=llm-27b -o name 2>/dev/null | head -1)"
  if [ -n "$pod" ]; then
    echo "KV cache (decides how far --max-model-len can go):"
    k logs "$pod" 2>/dev/null | grep -E 'Available KV cache memory|GPU KV cache size|Maximum concurrency' | tail -3 | sed 's/^/  /'
  fi
}

cmd_release() {
  local holds
  holds="$(live_holds)"
  [ -z "$holds" ] || die "still held by: $holds"
  k scale "deploy/$DEPLOY" --replicas=0
}

command -v kubectl >/dev/null || die "kubectl is not on PATH"
if ! k get --raw /version --request-timeout=8s >/dev/null 2>&1; then
  wg="$(ip link show warpdrive >/dev/null 2>&1 && echo up || echo 'not up')"
  die "aether's API does not answer (warpdrive is $wg). Off the LAN, bring warpdrive up and give aether-route-fallback up to 30 s to move the route; its decisions are in ~/.local/state/aether-route-fallback.log"
fi

case "${1:-}" in
  status) cmd_status; exit ;;
  release) cmd_release; exit ;;
esac

command -v "$CLIENT" >/dev/null || die "$CLIENT is not on PATH"
k get deploy "$DEPLOY" >/dev/null || die "cannot reach deploy/$DEPLOY in $KCTX/$NS"

renew_pid="" pf_pid=""
cleanup() {
  # The loops' children first: killing a subshell does not take its kubectl with it.
  for pid in $renew_pid $pf_pid; do
    kill "$pid" 2>/dev/null
    wait "$pid" 2>/dev/null
  done
  k delete lease "$LEASE" --ignore-not-found >/dev/null 2>&1 || true
}
trap cleanup EXIT
trap 'exit 130' INT TERM

# Hold first, so the reaper cannot take the model between our scale and our first request.
k apply -f - >/dev/null <<EOF
apiVersion: coordination.k8s.io/v1
kind: Lease
metadata:
  name: $LEASE
  labels:
    almagest.llm/hold: "true"
spec:
  holderIdentity: $LEASE
  leaseDurationSeconds: $LEASE_SECONDS
  renewTime: $(now)
EOF
# Each loop runs its child in the background and `wait`s, because a signal
# interrupts `wait` at once but waits out a foreground child - and the
# port-forward child never exits on its own.
( child=""
  trap 'kill $child 2>/dev/null; exit 0' TERM
  while :; do
    sleep 60 & child=$!; wait $child
    k patch lease "$LEASE" --type merge -p "{\"spec\":{\"renewTime\":\"$(now)\"}}" >/dev/null 2>&1 || true
  done ) &
renew_pid=$!

if [ "$(k get deploy almagest-llm -o jsonpath='{.spec.replicas}')" != "0" ]; then
  die "Almagest's Ollama (almagest-llm) has the GPU; the card is exclusive. Free it with: make k8s-model M=27b"
fi

if [ "$(k get deploy "$DEPLOY" -o jsonpath='{.spec.replicas}')" = "0" ]; then
  say "starting $DEPLOY (a cold start is minutes; the first ever start downloads ~16 GB)"
  k scale "deploy/$DEPLOY" --replicas=1 >/dev/null
fi

start=$SECONDS
until [ "$(k get deploy "$DEPLOY" -o jsonpath='{.status.readyReplicas}')" = "1" ]; do
  (( SECONDS - start < 3600 )) || die "$DEPLOY not ready after an hour; see: kubectl --context $KCTX -n $NS describe deploy/$DEPLOY"
  restarts="$(k get pods -l app.kubernetes.io/component=llm-27b \
    -o jsonpath='{.items[0].status.containerStatuses[0].restartCount}' 2>/dev/null)"
  # One restart is normal: a fresh pod's first start compiles in-process and
  # leaves too little KV memory, then the restart reuses the compile cache in /tmp.
  [[ $restarts =~ ^[0-9]+$ ]] || restarts=0
  if (( restarts > 1 )); then
    k logs -l app.kubernetes.io/component=llm-27b --previous --tail=200 2>/dev/null | grep -E 'Error|ValueError' | tail -2 >&2
    die "vLLM crashed on startup. Hand the GPU back with: aether-code release"
  fi
  why="$(k get pods -l app.kubernetes.io/component=llm-27b \
    -o jsonpath='{.items[0].status.phase} {.items[0].status.conditions[?(@.type=="PodScheduled")].message}' 2>/dev/null)"
  case "$why" in
    *Insufficient*gpu*) say "waiting: no GPU free (another namespace holds it) - $(( (SECONDS - start) / 60 ))m" ;;
    *) say "waiting for $DEPLOY: ${why:-pending} - $(( (SECONDS - start) / 60 ))m" ;;
  esac
  sleep 15
done

# Supervised: a bare port-forward dies on every pod restart.
( child=""
  trap 'kill $child 2>/dev/null; exit 0' TERM
  while :; do
    kubectl --context "$KCTX" -n "$NS" port-forward --address 127.0.0.1 "svc/$DEPLOY" "$PORT:8000" >/dev/null 2>&1 &
    child=$!
    wait $child
    sleep 1
  done ) &
pf_pid=$!

models=""
for _ in $(seq 30); do
  models="$(curl -sf --max-time 3 "http://127.0.0.1:$PORT/v1/models")" && break
  sleep 1
done
[ -n "$models" ] || die "port-forward to $DEPLOY never answered on 127.0.0.1:$PORT"

read -r MODEL WINDOW < <(python3 -I -c '
import json, sys
m = json.load(sys.stdin)["data"][0]
print(m["id"], m.get("max_model_len") or 16384)' <<<"$models")

OUT=$(( WINDOW / 4 < 4096 ? WINDOW / 4 : 4096 ))
say "model $MODEL, ${WINDOW}-token window, ${OUT}-token replies, holding lease $LEASE"

if [ "$CLIENT" = opencode ]; then
  # Inline config, so nothing is written to ~/.config/opencode and a plain
  # `opencode` keeps whatever setup it already has.
  OPENCODE_CONFIG_CONTENT="$(python3 -I - "$PORT" "$MODEL" "$WINDOW" "$OUT" <<'PY'
import json, sys
port, model, window, out = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4])
print(json.dumps({
    "$schema": "https://opencode.ai/config.json",
    "model": f"aether/{model}",
    "small_model": f"aether/{model}",
    "share": "disabled",
    "autoupdate": False,
    "provider": {"aether": {
        "npm": "@ai-sdk/openai-compatible",
        "name": "aether (vLLM)",
        "options": {"baseURL": f"http://127.0.0.1:{port}/v1", "apiKey": "aether"},
        "models": {model: {
            "name": f"Qwen on aether ({model})",
            "tool_call": True,
            "reasoning": True,
            "limit": {"context": window, "output": out},
        }},
    }},
}))
PY
)"
  export OPENCODE_CONFIG_CONTENT
  export OPENCODE_DISABLE_AUTOUPDATE=1 OPENCODE_DISABLE_MODELS_FETCH=1
  opencode "$@"
  exit
fi

export ANTHROPIC_BASE_URL="http://127.0.0.1:$PORT"
export ANTHROPIC_AUTH_TOKEN=aether
unset ANTHROPIC_API_KEY
export ANTHROPIC_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$MODEL"
export ANTHROPIC_SMALL_FAST_MODEL="$MODEL"
export CLAUDE_CODE_SUBAGENT_MODEL="$MODEL"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="$WINDOW"
export CLAUDE_CODE_MAX_OUTPUT_TOKENS="$OUT"

# Full Claude Code costs ~35k tokens before the first message (20 tool schemas
# alone are ~12k, almagest's CLAUDE.md files ~17k), so it only pays off once the
# window is big enough to leave real working room after it.
lean=()
if (( WINDOW < 98304 )) && [ -z "${AETHER_CODE_FULL:-}" ]; then
  export CLAUDE_CODE_DISABLE_CLAUDE_MDS=1
  export CLAUDE_CODE_DISABLE_AUTO_MEMORY=1
  export CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS=1
  lean=(--strict-mcp-config --disable-slash-commands --tools "Bash,Read,Edit,Write,Glob,Grep")
fi

claude --model "$MODEL" "${lean[@]}" "$@"
