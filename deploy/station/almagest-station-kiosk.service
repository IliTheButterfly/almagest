[Unit]
Description=Almagest station kiosk (Chromium on the bench display)
After=almagest-station-web.service
Wants=almagest-station-web.service

[Service]
# Not `Type=exec`: it arrived in systemd 240 and the bench Jetson runs 237,
# which rejects it outright and falls back to `simple`. See the api unit.
Type=simple
# The station's display is the one already logged in on tty1. This unit is a
# `--user` unit, so it inherits that session's environment except for DISPLAY,
# which systemd does not import.
Environment=DISPLAY=:0
# http://127.0.0.1 is a *secure context* per the spec even without TLS, which is
# the whole reason the kiosk points at loopback instead of https://almagest.aether.lan:
# `getUserMedia` exists here with no certificate and no private CA installed.
# `NDEFReader` still does not — kiosk Chromium has no Web NFC on any origin —
# and that gap is what the device bridge fills.
#
# `--password-store=basic` is what stops the "unlock your login keyring" dialog
# that otherwise appears over the kiosk on every boot. Chromium's default on a
# GNOME session is to keep its password store in gnome-keyring, and opening it
# makes `gcr-prompter` ask for the login password — which on a bench station that
# **autologins** is a password nobody is there to type, and which PAM never
# handed to gnome-keyring because no login password was entered. The dialog is
# therefore unanswerable by design, and it steals focus from the scan screen.
#
# `basic` keeps the store in the profile directory instead. That is a real
# downgrade — the store is then obfuscated rather than encrypted — and it is
# acceptable here for a reason specific to this machine and not to Chromium
# generally: **this profile stores no passwords.** The kiosk loads one loopback
# origin, the API on it has no login, and `--user-data-dir` is a directory that
# exists only for this unit. Do not copy this flag to a browser a person logs
# into things with.
ExecStart=/usr/bin/chromium-browser \
    --kiosk \
    --app=http://127.0.0.1:8080/scan \
    --user-data-dir=%h/.config/almagest-kiosk \
    --start-fullscreen \
    --noerrdialogs \
    --disable-infobars \
    --disable-session-crashed-bubble \
    --autoplay-policy=no-user-gesture-required \
    --use-fake-ui-for-media-stream \
    --password-store=basic
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
